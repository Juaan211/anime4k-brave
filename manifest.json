{
  "manifest_version": 3,
  "name": "Anime4K para Brave",
  "version": "0.3.1",
  "description": "Procesa videos de anime con Anime4K y WebGPU.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "models/*.onnx",
        "vendor/ort.webgpu.min.mjs",
        "vendor/ort-wasm-simd-threaded.asyncify.mjs",
        "vendor/ort-wasm-simd-threaded.asyncify.wasm",
        "assets/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}

